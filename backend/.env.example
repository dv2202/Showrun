NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://showcase:showcase@127.0.0.1:5432/showcase
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Creator/admin endpoints require this bearer token.
ADMIN_API_TOKEN=
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
PLAYWRIGHT_HEADLESS=true
# Optional when Playwright cannot find a bundled Chromium executable.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
SESSION_TTL_SECONDS=3600
PROXY_TIMEOUT_MS=15000
PROXY_MAX_RESPONSE_BYTES=10485760
PROXY_MAX_CONCURRENCY=100
LOG_LEVEL=info
