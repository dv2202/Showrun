NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://showcase:showcase@127.0.0.1:5432/showcase
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
AUTH_PUBLIC_API_URL=http://localhost:3000/backend-api
AUTH_COOKIE_NAME=showrun_session
AUTH_SESSION_TTL_SECONDS=2592000
# Configure OAuth apps with callback URLs:
# http://localhost:3000/backend-api/auth/oauth/github/callback
# http://localhost:3000/backend-api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLAYWRIGHT_HEADLESS=true
# Optional when Playwright cannot find a bundled Chromium executable.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
SESSION_TTL_SECONDS=3600
PROXY_TIMEOUT_MS=15000
PROXY_MAX_RESPONSE_BYTES=10485760
PROXY_MAX_CONCURRENCY=100
# Each viewer receives an isolated context in a shared Chromium process.
REMOTE_BROWSER_MAX_SESSIONS=20
REMOTE_BROWSER_IDLE_TTL_SECONDS=180
# Isolated public preview origins. Local Chromium resolves *.localhost automatically.
# Production ingress must route *.<domain> to this backend and preserve the Host header.
SHOWCASE_PREVIEW_PROTOCOL=http
SHOWCASE_PREVIEW_DOMAIN=localhost
SHOWCASE_PREVIEW_PORT=4000
# Temporary opt-in for the retired iframe/reverse-proxy viewer.
SHOWCASE_LEGACY_PATH_PROXY=false
LOG_LEVEL=info
