{
  "name": "showcase-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "undici": "^7.15.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
